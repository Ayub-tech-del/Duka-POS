# Get these from https://developer.safaricom.co.ke (create an app under "Lipa Na M-Pesa Online")
MPESA_ENV=sandbox
MPESA_CONSUMER_KEY=your_consumer_key
MPESA_CONSUMER_SECRET=your_consumer_secret

# Sandbox test shortcode is 174379 with Safaricom's public sandbox passkey (see Daraja docs)
MPESA_SHORTCODE=174379
MPESA_PASSKEY=your_passkey

# Must be a public HTTPS URL Safaricom can reach — use ngrok in dev:
# ngrok http 3000  ->  https://xxxx.ngrok-free.app/api/mpesa/callback
MPESA_CALLBACK_URL=https://your-domain-or-ngrok-url/api/mpesa/callback

PORT=3000
