# Get these from https://developer.safaricom.co.ke (create an app under "Lipa Na M-Pesa Online")
MPESA_ENV=sandbox
MPESA_CONSUMER_KEY=your_consumer_key
MPESA_CONSUMER_SECRET=your_consumer_secret

# Sandbox test shortcode is 174379 with Safaricom's public sandbox passkey (see Daraja docs)
MPESA_SHORTCODE=174379
MPESA_PASSKEY=your_passkey

# Must be a public HTTPS URL Safaricom can reach — use ngrok in dev:
# ngrok http 3000  ->  https://xxxx.ngrok-free.app/api/mpesa/callback
MPESA_CALLBACK_URL=https://your-domain-or-ngrok-url/api/mpesa/callback

PORT=3000

# Required in production — a long random string (e.g. `openssl rand -hex 32`).
# In dev, if left blank, an insecure default is used and a warning is printed.
SESSION_SECRET=

# Set to "production" when deployed (enables secure cookies, requires SESSION_SECRET).
NODE_ENV=development

# Comma-separated list of extra origins allowed to call the API with credentials
# (only needed if the frontend is hosted separately from this server). Same-origin
# requests always work without this.
ALLOWED_ORIGINS=

# Get these from https://console.cloud.google.com/apis/credentials — create an
# "OAuth 2.0 Client ID" (Web application). Add MPESA_CALLBACK_URL's host under
# "Authorized redirect URIs" as <your-domain>/api/auth/google/callback.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3000/api/auth/google/callback
